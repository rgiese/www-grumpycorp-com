<!doctype html>
<html lang="en">
  <!-- prettier-ignore -->
  <%
    const documentGroupName = data.inputDocument?.documentGroupName || "other";
    const frontMatter = data.inputDocument.frontMatter;
  %>

  <head>
    <!-- `meta` configuration: basics -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- `meta` configuration: metadata -->
    <meta name="author" content="Robin Giese" />

    <% if (frontMatter.keywords) { %>
    <meta name="keywords" content="<%= frontMatter.keywords.join(', ') %>" />
    <% } %>

    <!-- Document title and link -->
    <title><%= frontMatter.title %></title>
    <meta property="og:title" content="<%= frontMatter.title %>" />

    <!-- FavIcon and other theming -->
    <link rel="icon" href="/assets/icons/grumpy-robin.svg" />
    <meta name="theme-color" content="#f26739" />

    <!-- Style sheets -->
    <link href="/css/site.<%= data.siteBuildId %>.css" rel="stylesheet" />

    <!-- Font preloading -->
    <%~ ["dosis-v27-latin-regular", "questrial-v18-latin-regular", "quicksand-v30-latin-regular"].map((font) => `
    <link rel="preload" href="/fonts/${font}.woff2" as="font" type="font/woff2" crossorigin />
    `).join("") %>

    <!-- SimpleAnalytics -->
    <script async defer src="https://sa.grumpycorp.com/latest.js"></script>
    <noscript>
      <img src="https://sa.grumpycorp.com/noscript.gif" alt="" />
    </noscript>
  </head>

  <body>
    <div class="px-4 sm:pt-8 text-left bg-white">
      <!--
      * Three-column float layout: empty spacer [10%@sm / 20%@lg] | main [50%] | right [30%]
      * Columns stack vertically on small screens; flow-root clears the floats.
      -->
      <div class="flow-root">
        <div class="sm:float-left sm:w-[10%] lg:w-[20%]">&nbsp;</div>

        <div class="sm:float-left sm:w-1/2">
          <!-- Main div -->
          <main class="<%= documentGroupName === 'portfolio' ? 'max-w-5xl' : 'max-w-3xl' %> mx-auto pt-2">
            <!-- Logo on top for small screens -->
            <a href="/">
              <div class="mb-8 sm:hidden svg-studiosLogo w-[70%]"></div>
            </a>

            <!-- prettier-ignore -->
            <% if (documentGroupName === "posts") { %>
                <%~ include("posts/_header", data) %>
                <%~ include("posts/_prevnext", data) %>
            <% } else if (documentGroupName === "pages") { %>
                <%~ include("pages/_header", data) %>
            <% } else if (data.isHomePage) { %>
              <%~ include("home/_header", data) %>
              <% } %>

            <div class="leading-normal content <%= documentGroupName === 'portfolio' ? 'portfolio-container' : '' %>">
              <%~ data.contentHtml %>
            </div>

            <!-- prettier-ignore -->
            <% if (documentGroupName === "posts") { %>
                <%~ include("posts/_prevnext", data) %>
            <% } %>
          </main>
        </div>

        <div class="sm:float-left sm:w-[30%] print:hidden">
          <!-- Right div -->
          <nav class="max-w-64 pl-2 sm:pl-16 pb-4">
            <!-- Logo on the side for not-small screens -->
            <a href="/">
              <div class="mb-8 hidden sm:block svg-studiosLogo w-full"></div>
            </a>

            <%~ include("_rightbar", data) %>
          </nav>
        </div>
      </div>
    </div>
  </body>
</html>
