<section class="page-section content">
  <!-- Helper functions -->
  <% function renderTable(postTag, posts) { %>
  <h2 id="<%= encodeURIComponent(postTag) %>"><%~ data.tagPresenter(postTag) %></h2>
  <table>
    <tbody class="align-top leading-normal [&_td]:py-0.5">
      <% posts.forEach(function(postDocument) { %>
      <tr>
        <td>
          <a
            href="/tags/posts/<%= encodeURIComponent(postDocument.documentTag) %>"
            class="no-underline text-accent-mono"
          >
            <%~ data.tagPresenter(postDocument.documentTag) %>
          </a>
        </td>
        <td class="font-bold px-3"><%= postDocument.frontMatter.published.toLocaleString() %></td>
        <td>
          <a class="no-underline text-accent" href="/<%= postDocument.siteRelativeOutputPath %>"
            ><%= postDocument.frontMatter.title %></a
          >
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>

  <!-- Generate jumps to per-tag indexes -->
  <div>
    Jump to: <% data.postTags.forEach(function(postTag) { %>
    <a class="link-subdued pr-1" href="/tags/posts/<%= encodeURIComponent(postTag) %>"
      ><%~ data.tagPresenter(postTag) %></a
    >
    <% }) %>
  </div>

  <!-- Emit "all" index -->
  <% renderTable("all", data.postDocuments) %>

  <!-- Emit per-tag indexes -->
  <!-- prettier-ignore -->
  <% data.postTags.forEach(function(postTag) { %>
    <% renderTable(postTag, data.postDocuments.filter(postDocument => postDocument.documentTag === postTag)) %>
  <% }) %>
</section>
