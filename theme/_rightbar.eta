<div class="rightbar text-base leading-normal mx-auto">
  <h4>Pinned</h4>
  <% data.inputDocumentInventory.get("pages").forEach(function(inputDocument) { %>
  <div>
    <a class="link-subdued" href="/<%= inputDocument.siteRelativeOutputPath %>"
      ><%= inputDocument.frontMatter.title %></a
    >
  </div>
  <% }) %>

  <h4>Portfolio</h4>
  <% data.inputDocumentInventory.get("portfolio").forEach(function(inputDocument) { %>
  <div>
    <a class="link-subdued" href="/<%= inputDocument.siteRelativeOutputPath %>"
      ><%= inputDocument.frontMatter.title %></a
    >
  </div>
  <% }) %>

  <h4>Not a colophon</h4>

  <div class="colophon-row">&copy;2024 Grumpy Company Studios LLC.</div>

  <div class="colophon-row">Made with <span class="align-middle size-4 inline-block svg-heart"></span> in Seattle.</div>

  <div class="colophon-row">
    Licensed under
    <a class="link-subdued" href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">CC-BY-SA-4.0</a>.
  </div>

  <div class="colophon-row">
    Powered by
    <a class="link-subdued" href="https://tailwindcss.com">Tailwind</a> and
    <a class="link-subdued" href="https://pages.cloudflare.com/">Cloudflare</a>.
  </div>
</div>
