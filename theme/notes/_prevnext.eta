<div class="flex justify-between my-4 w-full">
  <div>
    <!-- prettier-ignore -->
    <% if (data.previousDocument) { %>
    <a class="text-black/40" href="/<%= data.previousDocument.siteRelativeOutputPath %>"
      >&laquo; <%= data.previousDocument.frontMatter.title %></a
    >
    <% } %>
  </div>
  <div class="text-right">
    <!-- prettier-ignore -->
    <% if (data.nextDocument) { %>
    <a class="text-black/40" href="/<%= data.nextDocument.siteRelativeOutputPath %>"
      ><%= data.nextDocument.frontMatter.title %> &raquo;</a
    >
    <% } %>
  </div>
</div>
