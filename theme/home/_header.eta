<div class="text-base text-black/60 home-page-tags-container">
  Latest post:
  <a href="/<%= data.latestPostDocument.siteRelativeOutputPath %>"><%= data.latestPostDocument.frontMatter.title %></a>
  in
  <a href="/tags/posts/<%= encodeURIComponent(data.latestPostTag) %>" class="no-underline text-accent-mono">
    <span class="svg-tag"></span>
    <%= data.latestPostTag %>
  </a>
</div>
