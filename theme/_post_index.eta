<table>
  <tbody class="align-top leading-normal [&_td]:py-0.5">
    <% data.postDocuments.forEach(function(postDocument) { %>
    <tr>
      <td>
        <a href="/tags/posts/<%= encodeURIComponent(postDocument.documentTag) %>" class="no-underline text-accent-mono">
          <%~ data.tagPresenter(postDocument.documentTag) %>
        </a>
      </td>
      <td class="font-bold px-3"><%= postDocument.frontMatter.published.toLocaleString() %></td>
      <td>
        <a class="no-underline text-accent" href="/<%= postDocument.siteRelativeOutputPath %>"
          ><%= postDocument.frontMatter.title %></a
        >
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
