<!doctype html>
<html lang="en">
  <!-- prettier-ignore -->
  <%
    const documentGroupName = data.inputDocument?.documentGroupName || "other";
    const frontMatter = data.inputDocument.frontMatter;
  %>

  <head>
    <!-- `meta` configuration: basics -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- `meta` configuration: metadata -->
    <meta name="author" content="Robin Giese" />

    <% if (frontMatter.keywords) { %>
    <meta name="keywords" content="<%= frontMatter.keywords.join(', ') %>" />
    <% } %>

    <!-- Document title and link -->
    <title><%= frontMatter.title %></title>
    <meta property="og:title" content="<%= frontMatter.title %>" />

    <!-- FavIcon and other theming -->
    <link rel="icon" href="/assets/packed/grumpy-robin.svg" />
    <meta name="theme-color" content="#f26739" />

    <!-- Font preloading -->
    <!-- prettier-ignore -->
    <%~ ["inter-v20-latin-regular", "inter-v20-latin-500", "inter-v20-latin-600"].map((font) => `
    <link rel="preload" href="/fonts/${font}.woff2" as="font" type="font/woff2" crossorigin />
    `).join("") %>

    <!-- Style sheets -->
    <link href="/css/site.<%= data.siteBuildId %>.css" rel="stylesheet" />

    <!-- SimpleAnalytics -->
    <script async defer src="https://sa.grumpycorp.com/latest.js"></script>
    <noscript>
      <img src="https://sa.grumpycorp.com/noscript.gif" alt="" referrerpolicy="no-referrer-when-downgrade" />
    </noscript>
  </head>

  <body>
    <!-- `min-h-screen`: be at least as tall as the viewport so full-page hero layouts function correctly -->
    <!-- `pt-nav-height`: add padding to account for fixed navbar height -->
    <!-- `print:pt-0`: nav is static in print so no compensation needed -->
    <main class="min-h-screen pt-nav-height print:pt-0 flex flex-col">
      <!-- Nav bar: fixed position at the top -> removed from layout flow for other page elements -->
      <nav class="nav" aria-label="Primary navigation">
        <a class="flex items-center gap-2" href="/">
          <div class="flex flex-col">
            <strong
              class="text-base font-medium uppercase leading-tight"
              style="color: color-mix(in oklab, var(--color-text) 70%, var(--color-muted))"
              >Grumpycorp Studios</strong
            >
            <span class="text-xs text-muted tracking-widest"
              >creative <span class="text-accent">/</span> engineering</span
            >
          </div>
          <span class="h-7 inline-block svg-grumpy-robin"></span>
        </a>
        <input type="checkbox" id="nav-mobile-toggle" class="nav-mobile-toggle" />
        <label for="nav-mobile-toggle" class="nav-hamburger" aria-label="Navigation menu"></label>
        <div class="nav-links do-not-print">
          <!-- prettier-ignore -->
          <% 
            const siteSections = ["phinneywood", "production", "collaborations", "notes", "about"];
          
            siteSections.forEach(section => { 
              const isActiveSection = data.inputDocument.siteRelativeOutputPath.startsWith(section + '/');
              const renderedSectionName = section.charAt(0).toUpperCase() + section.slice(1);
          %>

          <a href="/<%= section %>" class="<%= isActiveSection ? 'font-semibold' : '' %>"><%= renderedSectionName %></a>

          <% }) %>
        </div>
      </nav>

      <!-- Page content (not nested in other (non-`page-section`) divs so that the "did the previous section have an end border" logic for the colophon below works) -->
      <% if (frontMatter.useDefaultLayout) { %>
      <section class="page-section content">
        <!-- prettier-ignore -->
        <% if (documentGroupName === "notes") { %> 
          <%~ include("notes/_header", data) %> 
          <%~ include("notes/_prevnext", data) %> 
        <% } else { %>
        <h1><%= frontMatter.title %></h1>
        <% } %>

        <!-- prettier-ignore -->
        <%~ data.contentHtml %>

        <!-- prettier-ignore -->
        <% if (documentGroupName === "notes") { %> 
          <%~ include("notes/_prevnext", data) %> 
        <% } %>
      </section>
      <% } else { %> <%~ data.contentHtml %> <% } %>

      <!-- Colophon -->
      <section class="page-section colophon">
        <div class="grid">
          <div class="text-sm font-medium">Grumpycorp Studios</div>
          <div class="text-xs text-muted tracking-wide">Seattle, Washington</div>
        </div>

        <div class="text-sm text-muted flex gap-5 flex-wrap items-center do-not-print">
          <a href="https://www.imdb.com/name/nm8515322/">IMDb</a>
          <a href="https://www.instagram.com/grumpycorp/">Instagram</a>
          <a href="https://github.com/rgiese/">GitHub</a>
          <a href="mailto:hello@grumpycorp.com">Email</a>
          <a href="/privacy">Privacy</a>
        </div>
      </section>
    </main>
  </body>
</html>
