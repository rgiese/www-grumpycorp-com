<h1 class="mb-1"><a href="."><%= data.inputDocument.frontMatter.title %></a></h1>

<div class="text-base text-black/60">
  <%= data.inputDocument.frontMatter.published.toLocaleString() %>
  <span class="px-2 text-black/40">in</span>

  <a href="/tags/posts/<%= encodeURIComponent(data.documentTag) %>" class="no-underline accent-mono">
    <span class="svg-tag"></span>

    <%~ data.tagPresenter(data.documentTag) %>
  </a>
</div>
